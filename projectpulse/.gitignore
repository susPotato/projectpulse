.venv/
.venv-broken-*/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
pulse.db
data/demo/*.xlsx
# Anything else written into the data root: uploaded sheets, and workbooks
# converted from a customer's own export (scripts/from_jira_export.py). Real
# project data that happens to land in the working tree is not ours to commit.
# Any workbook under the data root, at any depth: uploaded sheets, workbooks
# converted from a customer's own export, and the generated demo sets. The
# earlier `data/*.xlsx` matched only the top level, so `data/upload_demo/*.xlsx`
# slipped into a commit - generated artifacts that go stale the moment the
# generator is re-run, since it dates them relative to today.
data/**/*.xlsx
data/*.xlsx

# Trained model artefacts. Downloaded on request by `scripts.fetch_model`, never
# committed - it is a third-party binary and the app treats its absence as a
# complete state.
#
# The leading slash is load-bearing. A bare `models/` matches a directory of
# that name at ANY depth, so it also swallowed `app/models/` - and because git
# ignores only *untracked* files, the tables committed before this line was
# added went on working while every new one was silently dropped from the
# commit. `app/models/narration.py` and `app/models/onedrive.py` were both lost
# that way, and the pushed tree could not import `app.db` at all.
/models/

# Runtime state a person edits, including an API key in plaintext.
.pulse/

# Local secrets - copy .env.example to .env and fill it in.
.env

# Screenshots from `python -m scripts.shots` - regenerate, never commit.
shots/
