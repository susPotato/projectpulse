# Copy this file to `.env` and fill in your key. `.env` is gitignored - never
# commit it. See README.md and app/config.py / app/llm/ for how each of these
# is read.

# --- Database -----------------------------------------------------------
# Only used when running the app directly (python -m scripts.serve) outside
# Docker. `docker compose up` sets DATABASE_URL itself, pointing the app
# container at the `db` service - this value is ignored there.
DATABASE_URL=postgresql+psycopg://pulse:pulse@localhost:5433/projectpulse

# --- Which model each feature uses --------------------------------------
# These two are the *defaults*. Every feature that calls a model - narration,
# risk drafts, the dashboard tile builder and the Agent tab - falls back to
# them, and any one of them can be pointed somewhere else on the
# `/llm` page without touching this file. See `app/llm/features.py`.
PULSE_NARRATION=1
PULSE_NARRATION_PROVIDER=anthropic
# Empty = the vendor's default model (see app/narration/providers.py).
PULSE_NARRATION_MODEL=

# Whether a model may *propose risks* by reading issue text. Its own switch,
# and emphatically not PULSE_NARRATION: narration only rephrases findings the
# engine computed, while this lets a model say something new. Turning on prose
# must not silently turn on claims.
PULSE_RISK_DRAFTS=0

# Put your key on the line for whichever provider you are using. Only one is
# needed, and a key set here is read by the vendor's own SDK - which is the
# recommended path. The `/llm` page is the alternative, for configuring a
# running app by hand; keys saved there are encrypted with PULSE_SECRET_KEY.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# FPT_API_KEY=

# --- Managing keys and settings from a browser ---------------------------
# Only needed if you want to change models or paste keys on a *deployed*
# instance. Without them, writes stay restricted to the machine the app runs
# on, exactly as before - which is a perfectly good way to run this.
#
#   python -m scripts.secret
#
# prints a fresh pair and the `fly secrets set` line for them.
#
# PULSE_SECRET_KEY encrypts the API keys stored in the database, so a dump or
# a backup discloses ciphertext rather than a usable credential. Losing it
# does not lose the app - only the stored keys, which then have to be pasted
# in again.
PULSE_SECRET_KEY=
# PULSE_ADMIN_TOKEN authorises changing settings through the browser. Unset
# means loopback-only, which is the default-deny this shipped with.
PULSE_ADMIN_TOKEN=

# --- The FPT AI gateway --------------------------------------------------
# PULSE_NARRATION_PROVIDER=fpt is the internal gateway at token-api.fpt.ai.
# It needs no SDK - the adapter speaks HTTP from the standard library - so it
# is the one provider that works with none of the optional extras installed.
#
# It serves a dozen models; pick one with PULSE_NARRATION_MODEL, e.g.
#   gemma-4-31B-it (the default)     GLM-5.2       Llama-3.3-70B-Instruct
#   gpt-oss-120b                     Qwen3.6-27B   DeepSeek-V4-Flash
#
# Nothing leaves FPT's network, which is the point for internal data.
#
# ⚠️ Its models ship **unpriced** on the usage board - there is no published
# per-token rate to seed, and an invented one would produce a confident figure
# that reconciles against nothing. Add rates on `/llm` and its calls start
# being costed; until then they are counted and flagged, not shown as free.
#
# The traceability verdicts (PULSE_TRACELINK_VERDICTS=1) can use the same
# gateway. Name the model with an `fpt:` prefix; FPT_API_KEY, or the key saved
# on `/llm`, is handed to the run. Unset means claude-opus-5.
# TRACELINK_MODEL=fpt:DeepSeek-V4-Flash   # 53/56 agreement with Opus; GLM-5.2 is the fast pick (52/56, 8s vs 21s)
