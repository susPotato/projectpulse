# Copy this file to `.env` and fill in your key. `.env` is gitignored - never
# commit it. See README.md and app/config.py / app/narration/store.py for how
# each of these is read.

# --- Database -----------------------------------------------------------
# Only used when running the app directly (python -m scripts.serve) outside
# Docker. `docker compose up` sets DATABASE_URL itself, pointing the app
# container at the `db` service - this value is ignored there.
DATABASE_URL=postgresql+psycopg://pulse:pulse@localhost:5433/projectpulse

# --- Narration (language model phrasing of findings) ---------------------
# Off by default; the deterministic template runs with none of this set.
PULSE_NARRATION=1
PULSE_NARRATION_PROVIDER=gemini
# Empty = the vendor's default model (see app/narration/providers.py).
PULSE_NARRATION_MODEL=

# Put your key on the line for whichever provider PULSE_NARRATION_PROVIDER
# is set to. Only one is needed.
GOOGLE_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
