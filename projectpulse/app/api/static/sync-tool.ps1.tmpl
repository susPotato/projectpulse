@echo off
rem  ProjectPulse - Jira sync.  Double-click this file.
rem
rem  A Windows command file on purpose, and not a .ps1. A default Windows
rem  install refuses to run a .ps1 at all - "running scripts is disabled on
rem  this system" - and refuses it again for having been downloaded, and the
rem  window closes before either message can be read. That is not something
rem  the script can fix from the inside, because it never starts.
rem
rem  A .cmd has no such restriction. This header hands the PowerShell below
rem  to an interpreter that is allowed to run it.
rem
rem  Note that the file as a whole is no longer valid PowerShell - these
rem  first lines are batch, and `@echo off` is a parse error to PowerShell.
rem  Everything from the marker line onward is, and that is the part the
rem  line below runs. To read or run it as PowerShell, take it from there.
rem
rem  The marker must appear exactly once in this file, which is why it is
rem  never written whole above it - not here, and not in the command below.
rem  Written whole, the search finds that line instead and PowerShell is
rem  handed the tail of this batch header: a syntax error nobody can place.
setlocal
set "PULSE_TOOL_PATH=%~f0"
rem  The marker is spelled in two halves here so that searching for the whole
rem  of it finds the real one further down, and not this line.
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$t = Get-Content -LiteralPath $env:PULSE_TOOL_PATH -Raw; Invoke-Expression $t.Substring($t.IndexOf('#__PS' + '__'))"
if errorlevel 1 pause
endlocal
exit /b
#__PS__
# ProjectPulse - Jira sync
#
# It reads issues from Jira and sends them to ProjectPulse. It runs on this
# computer on purpose: Jira refuses requests from the server but accepts
# them from an ordinary office machine, so the fetch has to happen here.
#
# Safe to run again at any time. It asks ProjectPulse what it already has
# and reads only what changed since, so the second run is quick. If Jira's
# gateway cuts you off part way, everything read up to that point has
# already been sent - run it again and it carries on from there.
#
# Nothing is installed. Nothing is left behind except a saved token, and
# only if you say yes.

$ErrorActionPreference = "Stop"
$ProgressPreference = "SilentlyContinue"

$Server     = "__SERVER__"
$JiraSite   = "__JIRA_SITE__"
$ProjectKey = "__PROJECT_KEY__"
$PushToken  = "__PUSH_TOKEN__"

# Jira's API refuses a client that announces itself as a script, so this
# sends what an ordinary browser sends. Same request, same permissions -
# it just does not look like a robot to the filter in front of Jira.
$Headers = @{
    "Accept"          = "application/json"
    "Accept-Language" = "en-US,en;q=0.9"
    "User-Agent"      = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/129.0.0.0 Safari/537.36"
}

# 25 at a time, and a pause between. Jira's gateway rejects bursts; this is
# the size and spacing that has been measured to get through.
$PageSize = 25
$Pace     = 4

# How many times to wait out a refusal that Jira has put a length on. A
# `Retry-After` is a temporary limit with a stated end, so waiting it out
# is exactly right and a few attempts are cheap.
$MaxRetries = 3

# The one blind wait, for a refusal with no `Retry-After`. A filter that is
# throttling an address rarely says how long and rarely means seconds, and
# requests made into it can restart the window rather than shorten it - so
# this happens once per run and then the tool stops and lets a person
# decide. Stopping costs nothing: everything read so far is already sent,
# and the next run resumes from the new watermark.
$PatientWait = 60

# A ceiling, so a project far larger than expected cannot walk for hours.
# 400 pages is 10,000 issues; reaching it is reported, not silent, and the
# next run resumes from where this one stopped.
$MaxPages = 400

# Only the fields anything downstream reads, instead of every field the
# site defines. A corporate Jira carries hundreds of custom fields and they
# are most of the weight of a response that also expands the changelog -
# which is the request the gateway refuses first.
#
# `customfield_10016` is story points *on Jira Cloud*. Data Center numbers
# its custom fields differently, and Jira rejects the WHOLE request with a
# 400 when `fields` names one that does not exist - so this list is an
# optimisation that has to be allowed to fail. If it is refused the script
# drops it and reads every field instead, which is what it did before this
# list existed: slower, larger, and correct everywhere.
$Fields = "project,summary,issuetype,status,assignee,created,updated,duedate,priority,labels,parent,description,customfield_10016"
$UseFields = $true

function Write-Step($text) { Write-Host $text -ForegroundColor Cyan }
function Write-Note($text) { Write-Host "  $text" -ForegroundColor DarkGray }
function Write-Bad($text)  { Write-Host $text -ForegroundColor Red }
function Write-Good($text) { Write-Host $text -ForegroundColor Green }

Write-Host ""
Write-Host "ProjectPulse - Jira sync" -ForegroundColor White
Write-Note "$ProjectKey  from  $JiraSite"
Write-Note "to  $Server"
Write-Host ""

# --- The Jira token -------------------------------------------------------
# Remembered next to this script so a second run asks nothing. It is your
# own Jira token; anyone who can read that file can use it, so the script
# asks before writing it down.
# Where this file is. `$PSScriptRoot` is empty when the batch header above
# runs the script through `Invoke-Expression` rather than as a file, so the
# header passes the path in an environment variable and this prefers it.
# The other two branches keep the file working when it is run as a plain
# .ps1, and when it is pasted into a console with no file at all.
$SelfPath = if ($env:PULSE_TOOL_PATH) { $env:PULSE_TOOL_PATH }
            elseif ($PSCommandPath)   { $PSCommandPath }
            else                      { $null }
$Here = if ($SelfPath) { Split-Path -Parent $SelfPath } else { (Get-Location).Path }

$TokenFile = Join-Path $Here ".jira-token"
if (Test-Path $TokenFile) {
    $JiraToken = (Get-Content $TokenFile -Raw).Trim()
    Write-Note "using the token saved beside this script"
} else {
    Write-Step "Paste your Jira API token"
    Write-Note "Jira > your profile > Personal Access Tokens"
    $secure = Read-Host "  Token" -AsSecureString
    $JiraToken = [Runtime.InteropServices.Marshal]::PtrToStringAuto(
        [Runtime.InteropServices.Marshal]::SecureStringToBSTR($secure))
    if (-not $JiraToken) { Write-Bad "No token given. Nothing to do."; Read-Host "Enter to close"; exit 1 }
    if ((Read-Host "  Remember it for next time? (y/N)") -match '^[Yy]') {
        Set-Content -Path $TokenFile -Value $JiraToken -Encoding utf8
        Write-Note "saved to $TokenFile"
    }
}
$JiraHeaders = $Headers.Clone()
$JiraHeaders["Authorization"] = "Bearer $JiraToken"

$pushHeaders = @{
    "Content-Type"        = "application/json"
    "X-Pulse-Admin-Token" = $PushToken
}

# --- What does ProjectPulse already have? ---------------------------------
# Without this the script re-reads the whole project every time, which is
# both slow and the thing that earns a refusal from Jira's gateway.
Write-Step "Asking ProjectPulse what it already has"
$Since = ""
try {
    $mark = Invoke-RestMethod -Uri "$Server/api/jira/watermark?project_key=$ProjectKey" -TimeoutSec 60
    $Since = $mark.since
    if ($Since) {
        Write-Note "$($mark.issues_held) issue(s) already there, newest change $Since"
        Write-Note "reading only what changed since then"
    } else {
        Write-Note "nothing there yet - reading the whole project"
    }
} catch {
    # Not fatal: a full read still works, it is just the slow one.
    Write-Note "could not ask (reading everything): $($_.Exception.Message)"
}

# --- Read from Jira, sending each page as it arrives ----------------------
# Sent per page rather than all at the end. A refusal half way through then
# costs the rest of the run and nothing else: what was read is already on
# the server, and the next run's watermark starts from there.
Write-Host ""
Write-Step "Reading $ProjectKey from Jira"

$jqlText = "project = ""$ProjectKey"""
if ($Since) { $jqlText += " AND updated >= ""$Since""" }
$jqlText += " ORDER BY updated ASC"
$jql = [uri]::EscapeDataString($jqlText)

$start = 0
$total = $null
$read = 0
$sent = 0
$pages = 0
$stoppedEarly = $false
# Per run, not per page: a filter throttling this address is throttling the
# next page too, so one patient wait is the budget for the whole run.
$BlindWaited = $false

function Send-Page($issues) {
    $body = @{ project_key = $ProjectKey; issues = $issues; url = "$JiraSite/rest/api/2/search" } |
        ConvertTo-Json -Depth 30 -Compress
    $reply = Invoke-RestMethod -Uri "$Server/api/jira/ingest" -Method Post `
        -Headers $pushHeaders -Body ([Text.Encoding]::UTF8.GetBytes($body)) -TimeoutSec 180
    return $reply
}

while ($pages -lt $MaxPages) {
    $page = $null
    for ($try = 0; $try -le $MaxRetries; $try++) {
        # Rebuilt each attempt, because a 400 on the field list turns it off
        # for the rest of the run and this is what picks that up.
        $url = "$JiraSite/rest/api/2/search?jql=$jql&startAt=$start&maxResults=$PageSize&expand=changelog"
        if ($UseFields) { $url += "&fields=$Fields" }

        try {
            $page = Invoke-RestMethod -Uri $url -Headers $JiraHeaders -TimeoutSec 60
            break
        } catch {
            $response = $_.Exception.Response
            $code = $null
            if ($response) { $code = $response.StatusCode.value__ }

            if ($code -eq 401) {
                Write-Bad "Jira rejected the token (401). Check it has not expired."
                Read-Host "Enter to close"; exit 1
            }

            # A 400 while asking for a named field list almost always means
            # this site does not have one of those fields - most likely
            # `customfield_10016`, which is story points on Cloud and
            # something else entirely on Data Center. Jira refuses the whole
            # request rather than the field, so drop the list and carry on
            # reading everything. Costs a larger response, not a failed sync.
            if ($code -eq 400 -and $UseFields) {
                $UseFields = $false
                Write-Note "this Jira refused the short field list - reading every field instead"
                $try--   # not one of the retry attempts; the request changed
                continue
            }

            # 403 is two different failures wearing one number, and only one
            # of them is worth waiting out.
            #
            # Jira's own 403 means the credential was accepted and this
            # account may not read the API - a permission on the account or a
            # restriction on the site. Retrying that just spends two minutes
            # to arrive at the same answer, and reports it as a rate limit,
            # which sends somebody looking for a queue that is not there.
            #
            # A bot filter in front of Jira also answers 403, but with an HTML
            # page rather than Jira's JSON. That one is the limiter, and
            # waiting is exactly right. Same rule `connect.py` uses.
            if ($code -eq 403) {
                $body = ""
                if ($_.ErrorDetails -and $_.ErrorDetails.Message) {
                    $body = $_.ErrorDetails.Message.TrimStart()
                }
                if ($body -notmatch '^\s*<(!doctype|html)') {
                    Write-Bad "Jira refused this account (403)."
                    Write-Note "The token was accepted, so this is not a wrong or expired one."
                    Write-Note "The account it belongs to is not allowed to read the API for"
                    Write-Note "$ProjectKey, or this site restricts API access generally."
                    Write-Note ""
                    Write-Note "Check by opening this in a browser where you are signed in:"
                    Write-Note "  $JiraSite/rest/api/2/myself"
                    Write-Note "JSON means the API is open to you and the token needs the"
                    Write-Note "right permission; the same 403 means the site is the limit."
                    if ($body) { Write-Note "" ; Write-Note $body }
                    Read-Host "Enter to close"; exit 1
                }
                Write-Note "a filter in front of Jira answered with a page, not Jira"
            }

            if ($code -eq 429 -or $code -eq 403 -or $code -eq 503) {
                $wait = 0
                if ($response) {
                    $retryAfter = $response.Headers["Retry-After"]
                    if ($retryAfter) { [int]::TryParse($retryAfter, [ref]$wait) | Out-Null }
                }

                # Jira named a length. A limit with a stated end is worth
                # waiting out, and it is telling us the truth about itself.
                if ($wait -gt 0) {
                    if ($try -ge $MaxRetries) {
                        Write-Bad "Jira kept refusing ($code) after waiting as asked."
                        $stoppedEarly = $true
                        break
                    }
                    Write-Note "refused ($code) - Jira asked for $wait s, waiting"
                    Start-Sleep -Seconds $wait
                    continue
                }

                # No length given. Wait once, patiently, and then stop -
                # requests made into a throttle can restart its window, so
                # retrying is how a short block becomes a long one.
                if ($BlindWaited) {
                    Write-Bad "Still refused ($code). This address is being rate limited."
                    Write-Note "Not the token and not the project - the same limit applies"
                    Write-Note "to a browser on this machine."
                    Write-Note ""
                    Write-Note "Leave it a while and run this again. Nothing is lost:"
                    Write-Note "$sent issue(s) are already saved and the next run picks up"
                    Write-Note "from there. Running it repeatedly now will extend the block."
                    $stoppedEarly = $true
                    break
                }
                $BlindWaited = $true
                Write-Note "refused ($code), no wait time given - waiting $PatientWait s"
                Start-Sleep -Seconds $PatientWait
                continue
            }

            # Jira puts the reason in the body, and throwing it away is how
            # "Jira answered 400" becomes a message nobody can act on. It is
            # this site's own words about this site's own fields.
            $detail = ""
            if ($_.ErrorDetails -and $_.ErrorDetails.Message) {
                $detail = $_.ErrorDetails.Message
                try {
                    $parsed = $detail | ConvertFrom-Json
                    if ($parsed.errorMessages) { $detail = ($parsed.errorMessages -join "; ") }
                } catch { }
            }
            if ($code) { Write-Bad "Jira answered $code." }
            else { Write-Bad "Could not reach Jira: $($_.Exception.Message)" }
            if ($detail) { Write-Note $detail }
            $stoppedEarly = $true
            break
        }
    }

    if ($null -eq $page) { break }

    # A challenge page comes back as HTML with a 200, so there is no error
    # to catch - it simply has no `issues`. Saying so beats "no issues came
    # back", which sends somebody to check a JQL that was never the problem.
    if ($null -eq $page.PSObject.Properties["issues"]) {
        Write-Bad "Jira's gateway answered with a page instead of data."
        Write-Note "That is the bot filter, not your token or your project key."
        Write-Note "Wait a few minutes and run this again - what was read is already sent."
        $stoppedEarly = $true
        break
    }

    $pages++
    if ($null -eq $total) { $total = $page.total; Write-Note "$total issue(s) to read" }

    $issues = @($page.issues)
    if ($issues.Count -eq 0) { break }
    $read += $issues.Count

    try {
        $reply = Send-Page $issues
        $sent += $reply.received
        Write-Note "read $read of $total - sent $sent - $($reply.tasks) task(s) on the site"
    } catch {
        Write-Bad "ProjectPulse refused the upload: $($_.ErrorDetails.Message)"
        Write-Note "Everything sent before this is already saved."
        Read-Host "Enter to close"; exit 1
    }

    $start += $issues.Count
    if ($start -ge $total) { break }
    Start-Sleep -Seconds $Pace
}

if ($pages -ge $MaxPages) {
    Write-Note "stopped at $MaxPages pages - run this again to carry on"
    $stoppedEarly = $true
}

# --- What happened --------------------------------------------------------
Write-Host ""
if ($sent -eq 0 -and -not $stoppedEarly) {
    Write-Good "Already up to date. Nothing has changed in Jira since the last sync."
} elseif ($stoppedEarly) {
    Write-Host "Stopped early. $sent issue(s) were sent and saved." -ForegroundColor Yellow
    Write-Note "Run this again when you can - it will carry on from here."
} else {
    Write-Good "Done. $sent issue(s) are now on $Server"
    Write-Note "Open the site and look at the Jira tab."
}
Write-Host ""
Read-Host "Enter to close"
