# Vendored reference repositories — read-only, never run, and each carries its own
# .git. Cloned fresh when needed:
#   git clone --depth 1 https://github.com/apache/devlake
#   git clone --depth 1 https://github.com/awsm-research/gpt2sp
devlake/
gpt2sp/

# Python
.venv/
.venv-broken-*/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Local database
*.db
pulse.db

# Generated demo data — rebuild with:
#   python -m scripts.gen_demo_data --step 0
#   python -m scripts.gen_jira_data
projectpulse/data/demo/*.xlsx
projectpulse/data/demo/jira/*.json

# Node / Cloudflare
node_modules/
.wrangler/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
*.swp

# Office lock files
~$*

# Competition source material, deliberately not published.
# These are inputs rather than deliverables, and the kickoff recording is an
# auto-transcribed meeting naming ~10 colleagues - not ours to republish.
Kickoff*.docx
PiMSatho_Overview.xlsx
ProjectPulseAI_PiMSathon.pptx

# Front end build artefacts. `openapi.json` is regenerated by `npm run types`.
# The built bundle in projectpulse/app/api/static/app/ is deliberately NOT
# ignored - it is committed so `python -m scripts.demo` never needs npm,
# because judges run the code.
projectpulse/web/scripts/openapi.json

# Stray console redirects from local smoke runs.
projectpulse/*.txt

# Local Claude Code tool config - per machine/session, not project content.
.claude/
