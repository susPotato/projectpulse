#   git clone --depth 1 https://github.com/apache/devlake
#   git clone --depth 1 https://github.com/awsm-research/gpt2sp
devlake/
gpt2sp/

# Python
.venv/
.venv-broken-*/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Local database
*.db
pulse.db

